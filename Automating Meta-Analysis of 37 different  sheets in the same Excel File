#making the function to loop:

analyze_and_plot <- function(dat, outcome_name) {
  dat$log_OR <- log(dat$OR)
  dat$se <- (log(dat$upper) - log(dat$lower)) / (2 * 1.96)
  
  
  res <- rma(yi = log_OR, sei = se, method = "REML", data = dat)
  
  n_studies <- res$k
  base_height <- 700
  height_per_study <- 15
  plot_height <- base_height + height_per_study * n_studies
  ub<-ceiling(exp(res$ci.ub))

  width_final <- 800 + (ub*80)
  
  a <- case_when(
    ub < 1 ~ round(ub),
    ub <= 2 ~ 1,
    ub > 2 ~ 1
  )
  
  b <- case_when(
    ub < 1 ~ round(ub + 1),
    ub <= 2 ~ round(ub + 1),
    ub > 2 ~ round(ub)
  )
  
  c <- case_when(
    ub < 1 ~ round(ub + 2),
    ub <= 2 ~ round(ub + 2),
    ub > 2 ~ round(ub+4)
  )
  d <- case_when(
    ub < 1 ~ round(-4),
    ub <= 2 ~ round(-4),
    ub > 2 ~ round(-8)
  )
  png(paste("forest_", outcome_name, ".PNG"), width = width_final, height = plot_height)
  forest(res,
         header = TRUE, at= c(0, a ,b ), 
         cex = 1.2,xlim= c(d,c+2),  alim = c(0, b),
         showweights = TRUE,
         refline = 1,
         shade = "zebra",order= "obs",
         transf = exp,
         mlab = mlabfun(outcome_name,res ),
         xlab = " Odds-Ratio(95%)", 
         slab = dat$ID)
text(-1, -5, "Protective", cex = 1 )
text( 2 , -5, "Risk Factor", cex = 1 )
  dev.off()
  
  return(res)
}
results_list <- mapply(analyze_and_plot, data_list, names(data_list), SIMPLIFY = FALSE)





